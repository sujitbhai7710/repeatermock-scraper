# RepeaterMock Scraper — Environment Variables
# Copy this file to .env and fill in your cookies.
#
# HOW TO GET COOKIES:
# 1. Log into https://repeatermock.com in your browser
# 2. Open DevTools → Application → Cookies → https://repeatermock.com
# 3. Copy the values of accessToken, refreshToken, totpVerified, guestId, rm_fe
# 4. Paste them below
#
# NOTE: accessToken expires in 15 minutes. refreshToken rotates on each use.
#       The scraper auto-refreshes and saves new cookies to data/cookies.json.

# ─── Option A: Individual cookies (simplest) ──────────────────────────────

REPEATERMOCK_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIs...
REPEATERMOCK_REFRESH_TOKEN=ebe0e1b36bc87caee29...
REPEATERMOCK_TOTP_VERIFIED=1
REPEATERMOCK_GUEST_ID=guest%3A764c0ec1a8738eeee04a1e2a234c3c2b
REPEATERMOCK_RM_FE=356497b0f96bcb98

# ─── Option B: Cookie string (from browser DevTools → Network → Request Headers) ──

# REPEATERMOCK_COOKIE_STRING=accessToken=eyJ...; refreshToken=ebe...; totpVerified=1; guestId=guest%3A...; rm_fe=356...

# ─── Option C: Full JSON array (from browser cookie export extension) ─────

# REPEATERMOCK_COOKIES_JSON=[{"name":"accessToken","value":"eyJ...","domain":".repeatermock.com","path":"/"},{"name":"refreshToken","value":"ebe...","domain":".repeatermock.com","path":"/"},...]

# ─── GitHub Actions (set as repository secrets) ───────────────────────────
# In GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# Name: REPEATERMOCK_COOKIES_JSON
# Value: the full JSON array from Option C
