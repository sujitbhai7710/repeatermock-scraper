# RepeaterMock Scraper — .env example
# Copy this file to .env and fill in the values

# Option 1: Set cookies as JSON array (recommended for local runs)
# Get this from your browser's Cookie-Editor extension after logging in to repeatermock.com
# REPEATERMOCK_COOKIES=[{"domain":".repeatermock.com","httpOnly":true,"name":"accessToken","path":"/","sameSite":"lax","secure":true,"value":"eyJ..."},{"domain":".repeatermock.com","httpOnly":true,"name":"refreshToken","path":"/","sameSite":"lax","secure":true,"value":"c0dd4..."},{"domain":".repeatermock.com","httpOnly":true,"name":"totpVerified","path":"/","sameSite":"lax","secure":true,"value":"1"}]

# Option 2: Use cookies/account1.json file (created automatically)

# Cloudflare D1 sync (optional — only needed if you want to push progress to the dashboard)
# CLOUDFLARE_API_TOKEN=cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
